# ─────────────────────────────────────────────────────────────
# AI Invest Lab 환경변수 예시. 복사해서 .env 로 쓰고, 절대 Git 에 올리지 마세요.
# 운영(GitHub Actions)은 Repository Secrets / Variables 에, 웹(Vercel)은 Project Env 에 넣습니다.
# ─────────────────────────────────────────────────────────────

# ── 엔진 (서버 전용) ──────────────────────────────────────────
AIL_MODE=demo                      # demo | live   (DEMO 와 실제 실험은 DB 에서 섞이지 않음)
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
AIL_EXPERIMENT=season-1
AIL_START_SESSION=                 # 비우면 다음 거래일. 예: 2026-12-01 (NYSE 거래일이어야 함)
AIL_INITIAL_CASH=100000
AIL_FEE_BPS=0
AIL_SLIPPAGE_BPS=5
AIL_MONTHLY_BUDGET_USD=10          # 예상 비용이 넘으면 그 회차는 AI 를 호출하지 않음
AIL_MAX_OUTPUT_TOKENS=4000
AIL_LLM_TIMEOUT=120

# NH투자증권 PLUG (시세 조회 전용 — 주문 API 는 코드에서 차단)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
NHPLUG_BASE_URL=https://api.nhplug.com:8443
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# OpenRouter
OPENROUTER_API_KEY=

# 참가 모델 (고정 ID. '~...-latest' 같은 자동교체 별칭은 거부됨)
# 실험 중 변경은 `ail set-model` 로 기록을 남긴 뒤 여기 값도 같이 바꾸세요.
AIL_MODEL_GPT=openai/gpt-4.1-mini
AIL_MODEL_CLAUDE=anthropic/claude-sonnet-5.5
AIL_MODEL_GEMINI=google/gemini-3.8-flash
AIL_MODEL_DEEPSEEK=deepseek/deepseek-v3.2

# ── 웹 (Vercel, 서버 측에서만 읽음 — NEXT_PUBLIC_ 금지) ─────────
DATA_MODE=demo                     # demo | live
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=                 # anon 키 + RLS 로 공개 테이블만 SELECT. service_role 키는 웹에 넣지 마세요.
SITE_ACCESS=private                # NH 시세 공개 재배포 권한 확인 전에는 private 유지
SITE_USER=lab
SITE_PASSWORD=
